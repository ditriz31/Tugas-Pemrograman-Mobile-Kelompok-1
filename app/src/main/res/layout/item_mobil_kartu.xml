<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu mobil kecil untuk daftar "Pilihan Mobil" di Beranda -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_kartu"
    android:orientation="vertical"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivMobil"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/putih_lembut"
        android:contentDescription="@string/foto_mobil"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_mobil"
        app:shapeAppearanceOverlay="@style/ShapeFotoMobil" />

    <TextView
        android:id="@+id/tvNamaMobil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lines="2"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHargaMobil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/merah_showroom"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
